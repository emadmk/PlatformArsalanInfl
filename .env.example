# Application
NODE_ENV=development
BACKEND_PORT=5000
FRONTEND_PORT=3000

# MongoDB
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DATABASE=micro_influencer

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=micro_influencer

# Redis
REDIS_PASSWORD=redis123

# Elasticsearch
ELASTIC_PASSWORD=elastic123

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 2FA
TWO_FACTOR_SECRET=your-2fa-secret-change-this

# Social Media APIs
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
YOUTUBE_API_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Crypto/Blockchain
WEB3_PROVIDER_URL_ETH=https://mainnet.infura.io/v3/YOUR-PROJECT-ID
WEB3_PROVIDER_URL_BSC=https://bsc-dataseed.binance.org/
WEB3_PROVIDER_URL_TRON=https://api.trongrid.io
PLATFORM_WALLET_ADDRESS=
PLATFORM_WALLET_PRIVATE_KEY=
USDT_CONTRACT_ADDRESS_ETH=0xdac17f958d2ee523a2206206994597c13d831ec7
USDT_CONTRACT_ADDRESS_BSC=0x55d398326f99059fF775485246999027B3197955
USDT_CONTRACT_ADDRESS_TRON=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# OneSignal
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@microinfluencer.com

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upload limits
MAX_FILE_SIZE=10485760
MAX_FILES_PER_UPLOAD=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Commission Rate (percentage)
DEFAULT_COMMISSION_RATE=20

# Minimum followers for auto-approval
MIN_INSTAGRAM_FOLLOWERS=1000
MIN_FACEBOOK_FOLLOWERS=1000
MIN_TWITTER_FOLLOWERS=1000
MIN_YOUTUBE_SUBSCRIBERS=1000
MIN_TIKTOK_FOLLOWERS=1000

# Analytics
GOOGLE_ANALYTICS_ID=

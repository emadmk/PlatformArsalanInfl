# Production environment variables
# Use relative URL so Nginx can proxy requests
NEXT_PUBLIC_API_URL=

# App settings
NEXT_PUBLIC_APP_NAME="Micro Influencer Platform"
NEXT_PUBLIC_APP_URL=https://arsalan.safiralux.com

# OneSignal (optional - add your keys if you have them)
# NEXT_PUBLIC_ONESIGNAL_APP_ID=your-app-id

# Analytics (optional)
# NEXT_PUBLIC_GA_TRACKING_ID=your-ga-id
